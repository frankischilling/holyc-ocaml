(executable
 (name test_native_cli)
 (modules test_native_cli)
 (libraries holyc_lib unix yojson))

(rule
 (alias native-tests)
 (deps
  ../../examples/native-integer-expression.hc
  ../../examples/native-integer-predicates.hc
  ../../examples/native-integer-logical.hc
  ../../examples/native-integer-spills.hc
  ../../examples/native-integer-shifts.hc
  ../../examples/native-integer-divmod.hc)
 (action
  (run
   %{exe:test_native_cli.exe}
   %{exe:../../bin/holyc.exe}
   %{dep:../../examples/native-integer-expression.hc}
   %{dep:../../examples/native-integer-predicates.hc}
   %{dep:../../examples/native-integer-logical.hc}
