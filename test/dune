(rule
 (alias runtest)
 (targets parse-error.human.actual parse-error.human.stdout.actual)
 (deps cli/parse-error.hc cli/parse-error.human)
 (action
  (progn
   (with-stdout-to
    parse-error.human.stdout.actual
    (with-stderr-to
     parse-error.human.actual
     (with-accepted-exit-codes
      1
      (run %{exe:../bin/holyc.exe} parse cli/parse-error.hc))))
   (diff cli/parse-error.human parse-error.human.actual))))

(rule
 (alias runtest)
 (targets parse-error.json.actual parse-error.json.stdout.actual)
 (deps cli/parse-error.hc cli/parse-error.json)
 (action
  (progn
   (with-stdout-to
    parse-error.json.stdout.actual
    (with-stderr-to
     parse-error.json.actual
     (with-accepted-exit-codes
      1
      (run %{exe:../bin/holyc.exe} parse --format=json cli/parse-error.hc))))
   (diff cli/parse-error.json parse-error.json.actual))))
