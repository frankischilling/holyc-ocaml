(rule
 (alias runtest)
 (targets
  assert-warning.human.tokens.actual
  assert-warning.human.diagnostics.actual)
 (deps
  cli/assert-warning.hc
  cli/assert-warning.human.tokens
  cli/assert-warning.human.diagnostics)
 (action
  (progn
   (with-stdout-to
    assert-warning.human.tokens.actual
    (with-stderr-to
     assert-warning.human.diagnostics.actual
     (run %{exe:../bin/holyc.exe} preprocess cli/assert-warning.hc)))
   (diff cli/assert-warning.human.tokens assert-warning.human.tokens.actual)
   (diff
    cli/assert-warning.human.diagnostics
    assert-warning.human.diagnostics.actual))))

