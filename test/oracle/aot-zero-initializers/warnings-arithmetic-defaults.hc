U0 POOut(U8 *s) {while (*s) OutU8(0xE9,*s++);}
U0 POValue(U8 *name,I64 value) {U8 buf[80];StrPrint(buf,"%s=%d\n",name,value);POOut(buf);}
U8 *AWSource="#include \"/Kernel/KernelA.HH\"\nclass AWBox{U0 empty;I64 value;};\n#exe {POValue(\"START\",Fs->last_cc->warning_cnt);}\nI64 AWADD(I64 n=3+4){return n;}AWBox AWADDO={AWADD(),42};\n#exe {POValue(\"ADD\",Fs->last_cc->warning_cnt);}\nI64 AWSUB(I64 n=8-1){return n;}AWBox AWSUBO={AWSUB(),42};\n#exe {POValue(\"SUB\",Fs->last_cc->warning_cnt);}\nI64 AWMUL(I64 n=7*1){return n;}AWBox AWMULO={AWMUL(),42};\n#exe {POValue(\"MUL\",Fs->last_cc->warning_cnt);}\nI64 AWAND(I64 n=15&7){return n;}AWBox AWANDO={AWAND(),42};\n#exe {POValue(\"AND\",Fs->last_cc->warning_cnt);}\nI64 AWOR(I64 n=3|4){return n;}AWBox AWORO={AWOR(),42};\n#exe {POValue(\"OR\",Fs->last_cc->warning_cnt);}\nI64 AWXOR(I64 n=3^4){return n;}AWBox AWXORO={AWXOR(),42};\n#exe {POValue(\"XOR\",Fs->last_cc->warning_cnt);}\nI64 AWSHL(I64 n=1<<2){return n;}AWBox AWSHLO={AWSHL(),42};\n#exe {POValue(\"SHL\",Fs->last_cc->warning_cnt);}\nI64 AWSHR(I64 n=8>>1){return n;}AWBox AWSHRO={AWSHR(),42};\n#exe {POValue(\"SHR\",Fs->last_cc->warning_cnt);}\nI64 AWNEG(I64 n=-7){return n;}AWBox AWNEGO={AWNEG(),42};\n#exe {POValue(\"NEG\",Fs->last_cc->warning_cnt);}\nI64 AWNEST(I64 n=(3+4)*1){return n;}AWBox AWNESTO={AWNEST(),42};\n#exe {POValue(\"NEST\",Fs->last_cc->warning_cnt);}\n";
FileWrite("B:/AWAD.HC",AWSource,StrLen(AWSource));
POValue("COMPILE_ERRORS",Cmp("B:/AWAD.HC"));
POOut("POINTER_DONE\n");
