U0 POOut(U8 *s) {while (*s) OutU8(0xE9,*s++);}
U0 POValue(U8 *name,I64 value) {U8 buf[80];StrPrint(buf,"%s=%d\n",name,value);POOut(buf);}
U8 *AWSource="#include \"/Kernel/KernelA.HH\"\nclass AWBox{U0 empty;I64 value;};I64 AWGet(I64 n){return n;}\n#exe {POValue(\"START\",Fs->last_cc->warning_cnt);}\nI8 AWI8N=7;AWBox AWI8O={AWGet(AWI8N),42};\n#exe {POValue(\"I8\",Fs->last_cc->warning_cnt);}\nU8 AWU8N=7;AWBox AWU8O={AWGet(AWU8N),42};\n#exe {POValue(\"U8\",Fs->last_cc->warning_cnt);}\nI16 AWI16N=7;AWBox AWI16O={AWGet(AWI16N),42};\n#exe {POValue(\"I16\",Fs->last_cc->warning_cnt);}\nU16 AWU16N=7;AWBox AWU16O={AWGet(AWU16N),42};\n#exe {POValue(\"U16\",Fs->last_cc->warning_cnt);}\nI32 AWI32N=7;AWBox AWI32O={AWGet(AWI32N),42};\n#exe {POValue(\"I32\",Fs->last_cc->warning_cnt);}\nU32 AWU32N=7;AWBox AWU32O={AWGet(AWU32N),42};\n#exe {POValue(\"U32\",Fs->last_cc->warning_cnt);}\nI64 AWI64N=7;AWBox AWI64O={AWGet(AWI64N),42};\n#exe {POValue(\"I64\",Fs->last_cc->warning_cnt);}\nU64 AWU64N=7;AWBox AWU64O={AWGet(AWU64N),42};\n#exe {POValue(\"U64\",Fs->last_cc->warning_cnt);}\nF64 AWF64N=7;AWBox AWF64O={AWGet(AWF64N),42};\n#exe {POValue(\"F64\",Fs->last_cc->warning_cnt);}\nBool AWBoolN=7;AWBox AWBoolO={AWGet(AWBoolN),42};\n#exe {POValue(\"Bool\",Fs->last_cc->warning_cnt);}\n";
FileWrite("B:/AWGT.HC",AWSource,StrLen(AWSource));
POValue("COMPILE_ERRORS",Cmp("B:/AWGT.HC"));
POOut("POINTER_DONE\n");
