U0 POOut(U8 *s) {while (*s) OutU8(0xE9,*s++);}
U0 POValue(U8 *name,I64 value) {U8 buf[80];StrPrint(buf,"%s=%d\n",name,value);POOut(buf);}
U8 *AWSource="#include \"/Kernel/KernelA.HH\"\nclass AWBox{U0 empty;I64 value;};\n#exe {POValue(\"START\",Fs->last_cc->warning_cnt);}\nI64 AWI8(I8 n=7){return n;}AWBox AWI8O={AWI8(),42};\n#exe {POValue(\"I8\",Fs->last_cc->warning_cnt);}\nI64 AWU8(U8 n=7){return n;}AWBox AWU8O={AWU8(),42};\n#exe {POValue(\"U8\",Fs->last_cc->warning_cnt);}\nI64 AWI16(I16 n=7){return n;}AWBox AWI16O={AWI16(),42};\n#exe {POValue(\"I16\",Fs->last_cc->warning_cnt);}\nI64 AWU16(U16 n=7){return n;}AWBox AWU16O={AWU16(),42};\n#exe {POValue(\"U16\",Fs->last_cc->warning_cnt);}\nI64 AWI32(I32 n=7){return n;}AWBox AWI32O={AWI32(),42};\n#exe {POValue(\"I32\",Fs->last_cc->warning_cnt);}\nI64 AWU32(U32 n=7){return n;}AWBox AWU32O={AWU32(),42};\n#exe {POValue(\"U32\",Fs->last_cc->warning_cnt);}\nI64 AWI64(I64 n=7){return n;}AWBox AWI64O={AWI64(),42};\n#exe {POValue(\"I64\",Fs->last_cc->warning_cnt);}\nI64 AWU64(U64 n=7){return n;}AWBox AWU64O={AWU64(),42};\n#exe {POValue(\"U64\",Fs->last_cc->warning_cnt);}\nI64 AWF64(F64 n=7){return n;}AWBox AWF64O={AWF64(),42};\n#exe {POValue(\"F64\",Fs->last_cc->warning_cnt);}\nI64 AWBool(Bool n=7){return n;}AWBox AWBoolO={AWBool(),42};\n#exe {POValue(\"Bool\",Fs->last_cc->warning_cnt);}\n";
