      "id": "core-local-forms-and-for-rejection",
      "command": "ExePrint(\"I64 OracleAuto(I64 arg){I64 reg R15 value=arg,noreg count=2;U8 bytes[2][3];I64 *ptr=&value;return *ptr+count;}\\nI64 OracleStatic(){static I64 count=40,other=1;return ++count+other;}\\nI64 OracleVar(I64 arg,...){I64 count=argc;I64 *args=argv;return arg;}\\nI64 OracleNested(){{I64 inner=9;}return inner;}\\nI64 OracleSelf(){I64 value=defined(value);return value;}\\nI64 OracleFor(){I64 total=0;for(I64 i=0;i<3;i++)total+=i;return total;}\\n\");",
      "outcome": "The first five definitions compiled. OracleFor was rejected with Missing )."
    },
    {
      "id": "statement-continuation-forms",
      "command": "ExePrint(\"I64 OracleComma(){I64 x=1;,I64 y=2;return x+y;}\\nI64 OracleIfFalse(){I64 out=0;if(0) I64 branch=1;out=7;return out;}\\nI64 OracleIfBlock(){I64 out=0;if(0){I64 branch=1;}out=7;return out;}\\nI64 OracleLock(){I64 out=0;lock I64 guarded=1;out=8;return out;}\\n\");",
      "outcome": "All four definitions compiled. The compiler reported only unused-local warnings."
    }
