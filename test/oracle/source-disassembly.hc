// Run with the pinned TempleOS final ISO. Output uses QEMU's debug console.
U0 DCapture(I64 id,U8 *p,I64 count,I64 bits=64)
{
  U8 text[1024],record[4096],*start;
  I64 i,j,target;
  for (i=0;i<count;i++) {
    start=p;
    Ui(text,&p,bits,&target,TRUE);
    StrPrint(record,"DOR|%d|%d|%X|%d|%X|",id,bits,start,p-start,target);
    for (j=0;j<p-start;j++) CatPrint(record,"%02X",start[j]);
    CatPrint(record,"|%s",text);
    for (j=0;j<StrLen(record);j++) OutU8(0xE9,record[j]);
  }
}
