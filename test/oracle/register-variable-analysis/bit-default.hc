U0 P(U8 *n,I64 v){U8 b[80],*p=b;StrPrint(b,"%s=%d\n",n,v);while(*p)OutU8(0xE9,*p++);}U8 *s="#include \"/Kernel/KernelA.HH\"\n#exe {I64 FOR(I8 x,I64 c){x|=c;return x;}I64 IOR(){return FOR(127,256);}I64 SOR(I64 n=IOR()){return n;}P(\"OR\",SOR());I64 FXOR(I8 x,I64 c){x^=c;return x;}I64 IXOR(){return FXOR(127,256);}I64 SXOR(I64 n=IXOR()){return n;}P(\"XOR\",SXOR());I64 FAND(I8 x,I64 c){x&=c;return x;}I64 IAND(){return FAND(-1,255);}I64 SAND(I64 n=IAND()){return n;}P(\"AND\",SAND());}\n";FileWrite("B:/BD.HC",s,StrLen(s));P("ERR",Cmp("B:/BD.HC"));U8 *z="POINTER_DONE\n";while(*z)OutU8(0xE9,*z++);