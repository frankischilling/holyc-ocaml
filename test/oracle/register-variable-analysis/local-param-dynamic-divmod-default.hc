U0 P(U8 *n,I64 v){U8 b[80],*p=b;StrPrint(b,"%s=%d\n",n,v);while(*p)OutU8(0xE9,*p++);}U8 *s="#include \"/Kernel/KernelA.HH\"\n#exe {I64 FS(I64 c,I8 n){I8 x=c;x/=n;return x;}I64 IS(){return FS(255,2);}I64 S(I64 n=IS()){return n;}P(\"DIV\",S());I64 FR(I64 c,I8 n){I8 x=c;x%=n;return x;}I64 IR(){return FR(255,2);}I64 R(I64 n=IR()){return n;}P(\"MOD\",R());I64 FM(I64 c,I8 n){I8 x=c;x*=n;return x;}I64 IM(){return FM(255,3);}I64 M(I64 n=IM()){return n;}P(\"MUL\",M());}\n";FileWrite("B:/RETDEF.HC",s,StrLen(s));P("ERR",Cmp("B:/RETDEF.HC"));U8 *z="POINTER_DONE\n";while(*z)OutU8(0xE9,*z++);