U0 POut(U8 *n,I64 v){U8 b[80],*p=b;StrPrint(b,"%s=%d\n",n,v);while(*p)OutU8(0xE9,*p++);}U8 *s="#include \"/Kernel/KernelA.HH\"\n#exe {I64 FA(I8 reg R12 x,I64 c){x<<=c;return x;}I64 FB(){U8 reg R15 x=255;x<<=1;return x;}POut(\"PARAM\",FA(127,1));POut(\"LOCAL\",FB());}\n";FileWrite("B:/RETDEF.HC",s,StrLen(s));POut("ERR",Cmp("B:/RETDEF.HC"));U8 *z="POINTER_DONE\n";while(*z)OutU8(0xE9,*z++);