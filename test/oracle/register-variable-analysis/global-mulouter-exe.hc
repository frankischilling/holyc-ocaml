U0 POut(U8 *n,I64 v){U8 b[80],*p=b;StrPrint(b,"%s=%d\n",n,v);while(*p)OutU8(0xE9,*p++);}U8 *s="#include \"/Kernel/KernelA.HH\"\n#exe {U8 A=255,B=0;I64 ID(I64 x){return x;}I64 FA(){return (A+=1)*2;}I64 FB(){return (B-=1)*2;}POut(\"ADD\",FA());POut(\"SUB\",FB());}\n";FileWrite("B:/RETDEF.HC",s,StrLen(s));POut("ERR",Cmp("B:/RETDEF.HC"));U8 *z="POINTER_DONE\n";while(*z)OutU8(0xE9,*z++);